#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 (roundrobin)
apt-get update -y
apt-get install -y haproxy
if [ -f /etc/default/haproxy ]
then
  sed -i 's/^ENABLED=0/ENABLED=1/' /etc/default/haproxy
fi
if ! grep -q "http_back" /etc/haproxy/haproxy.cfg
then
  cat >> /etc/haproxy/haproxy.cfg << 'CFG'

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7367-web-01 52.56.72.29:80 check
    server 7367-web-02 18.169.157.38:80 check
CFG
fi
service haproxy restart
