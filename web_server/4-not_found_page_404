#!/usr/bin/env bash
# Installs nginx, adds the redirect and a custom 404 page
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html
grep -q "redirect_me" /etc/nginx/sites-enabled/default || sed -i '/server_name _;/a rewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' /etc/nginx/sites-enabled/default
grep -q "custom_404" /etc/nginx/sites-enabled/default || sed -i '/server_name _;/a error_page 404 /custom_404.html;' /etc/nginx/sites-enabled/default
service nginx restart
